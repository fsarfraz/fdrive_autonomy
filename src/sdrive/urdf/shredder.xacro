<?xml version="1.0"?>
<robot name="shredder" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ========== MATERIALS ========== -->
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  
  <!-- ========== BASE LINK (Robot Chassis) ========== -->
  <link name="base_link">
    <visual>
      <geometry>
        <!-- Your robot dimensions: 134cm length x 70cm width x 60cm height -->
        <box size="1.24 0.70 0.58"/>
      </geometry>
      <!-- base_link is now at center of chassis (z=0 in base_link frame) -->
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size="1.34 0.70 0.60"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </collision>

    <!-- Inertial properties (estimated for ~100kg robot) -->
    <inertial>
      <mass value="100.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="6.45" ixy="0.0" ixz="0.0" iyy="18.00" iyz="0.0" izz="21.77"/>
    </inertial>
  </link>
  
  <link name="os_lidar">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
    
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="os_lidar"/>
    <origin xyz="0.67 0 0.34" rpy="0 -0.314159 3.14159"/>
  </joint>

  <link name="os_imu">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    
    <inertial>
      <mass value="0.015"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" 
              iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="os_imu"/>
    <origin xyz="0.676253 0 0.347645" rpy="0 0.314159 0"/>
  </joint>
  
</robot>